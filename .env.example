# Copy to .env.local to enable real email sending.
#
# 1) Sign up free at https://resend.com (no credit card)
# 2) Create an API key from the dashboard
# 3) Paste it below
#
# Without this key, the OTP and order emails are skipped on the server
# but the OTP code is returned to the UI in dev mode so you can still
# complete the checkout flow end-to-end.

RESEND_API_KEY=

# Optional: set a verified sender. Defaults to "Shanky <onboarding@resend.dev>"
# which works out of the box on the Resend free tier.
EMAIL_FROM=Shanky <onboarding@resend.dev>
