# ── Supabase Postgres (REQUIRED) ─────────────────────────────────────────
# Project Settings → Database → Connection string → URI tab
#   • Local dev: any mode works; the Direct connection (port 5432) is fine.
#   • Vercel deploy: you MUST use the Transaction pooler (port 6543).
# After copying, replace [YOUR-PASSWORD] with your actual database password
# (DON'T leave the brackets). If your password contains @ # / ? : & = % [ ],
# reset it to something with only letters/digits/-/_/. — URL encoding is a pain.
DATABASE_URL=postgresql://postgres:3qh545Brs-@66#F@db.jzhtrlfgypfbunlmaehq.supabase.co:5432/postgres

# ── Supabase Storage (REQUIRED for product image uploads) ────────────────
# Project Settings → API → Project URL  (safe to expose if needed)
SUPABASE_URL=https://jzhtrlfgypfbunlmaehq.supabase.co

# Project Settings → API → service_role key — SERVER ONLY.
# (NOT the anon key. The anon key can't write to storage.)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp6aHRybGZneXBmYnVubG1hZWhxIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3ODIyMjE0NiwiZXhwIjoyMDkzNzk4MTQ2fQ.QVWjwD9iTxeoXL_LuteADDAujtA5nNixjJb8fBBCrrs

# Bucket name. Default is "shanky" if unset — only change this if you
# created the bucket with a different name.
SUPABASE_STORAGE_BUCKET=shanky

# ── App secrets (REQUIRED — used to sign session cookies) ────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Run twice, paste each output here. Never commit real values.
USER_SECRET=GENERATE_A_LONG_RANDOM_STRING
ADMIN_SECRET=GENERATE_ANOTHER_LONG_RANDOM_STRING

# ── Razorpay (OPTIONAL — demo mode runs if blank) ────────────────────────
# Razorpay dashboard → Settings → API Keys → generate. Use TEST keys locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Resend (OPTIONAL — emails are skipped if blank) ──────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=
EMAIL_FROM=Shanky <gbhavanbkr@gmail.com>
